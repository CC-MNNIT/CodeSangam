# Copy to client/.env. deploy.sh regenerates this file, so local edits are lost.
#
# REACT_APP_BASE_URL is the path the app is served under, without a leading
# slash. Root hosting (the live setup) = empty. Subdirectory hosting, e.g.
# /codesangam, = "codesangam". Every client route is built from this value.
REACT_APP_BASE_URL=

# Only used by `npm start`; irrelevant for the production build.
PORT=3001

# Rankings endpoints. These are passed to axios.get verbatim - route() is not
# applied to them - so a subdirectory deployment has to include the base path
# itself. Each must be a URL that returns a JSON array, and map the event key:
# /api/v1/cs/ranking?event=droidrush (the client route is "logicalrhythm" but
# the server accepts "logical"). Leaving one empty gives a silent "to be
# announced": the request falls through to this app's own index.html, so no
# leaderboard ever renders.
REACT_APP_WEBSTER_RANKINGS_DATA_API=
REACT_APP_DROIDRUSH_RANKINGS_DATA_API=
REACT_APP_LOGICALRHYTHM_RANKINGS_DATA_API=
REACT_APP_SOFTABLITZ_RANKINGS_DATA_API=
