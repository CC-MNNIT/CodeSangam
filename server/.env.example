# Copy to server/.env and fill in. NEVER commit the real file.
#
# Only BASE_URL, PORT and REDIRECT_URL are touched by deploy.sh; the secrets
# below are left alone.

# Path the API is mounted under. Must match REACT_APP_BASE_URL in
# client/.env. Root hosting = empty. This is also what the server-rendered
# login/dashboard templates use to build their action and asset URLs.
BASE_URL=

# Port the Go server listens on (nginx proxies /api/ to it).
PORT=8082

# Google OAuth callback. Must be listed verbatim in the Google Cloud console
# under the OAuth client's authorised redirect URIs.
REDIRECT_URL=https://codesangam.cc-club.in/api/auth/callback

# Unix timestamp (seconds) after which team registration and abstract
# submission are rejected. This is a real cutoff: DeadlineMiddleware enforces
# it on POST /api/v1/cs/register and POST /api/v1/cs/abstract. Moving it needs
# only a backend restart - no rebuild, no deploy:
#   date -d "2026-10-20 00:00:00 IST" +%s   # 1792434600
# The instant itself is the last second accepted, so 1792434600 means "open
# until 23:59:59 IST on 19 Oct". Leave it empty and registration never closes.
REGISTRATION_DEADLINE=

# Results visible to participants. GET /api/v1/cs/ranking returns an empty list
# while this is false, and the client hides its leaderboards behind
# RESULTS_ANNOUNCED in client/src/Utils/Config.tsx - flip both after the event.
DECLARE_RESULT=false

# Signs the session cookie: openssl rand -hex 32
SESSION_SECRET=

# Event database.
DB_URL=codesangam:CHANGE_ME@tcp(127.0.0.1:3306)/codesangam?charset=utf8mb4&parseTime=True&loc=Local

# ContriHUB database. Optional this season: point it at any empty MySQL schema
# so the startup connection check in config/connectDb.go succeeds; the
# ContriHUB leaderboard then simply returns [].
CONTRI_DB_URL=codesangam:CHANGE_ME@tcp(127.0.0.1:3306)/contrihub?charset=utf8mb4&parseTime=True&loc=Local

# Google OAuth client for sign-in.
CLIENT_ID=
CLIENT_SECRET=
